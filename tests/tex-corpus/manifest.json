{
  "schema_version": 1,
  "contract": "runtime-v1",
  "offset_unit": "utf8_bytes",
  "range_end": "exclusive",
  "support_policy": "All cases are requirements, not verified engine support. Record compiler evidence separately.",
  "cases": [
    {
      "id": "plain-paragraphs",
      "description": "Baseline nonempty document and paragraph separation.",
      "profile": "latex-basic",
      "features": [
        "text",
        "paragraphs"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "visible_text",
          "source": {
            "path": "main.tex",
            "start_byte": 41,
            "end_byte": 57,
            "text": "First paragraph."
          },
          "detail": "First paragraph. appears before Second paragraph.; blank source line creates a paragraph boundary."
        },
        {
          "kind": "visible_text",
          "source": {
            "path": "main.tex",
            "start_byte": 59,
            "end_byte": 76,
            "text": "Second paragraph."
          },
          "detail": "Second paragraph. remains visible in the same source order."
        }
      ]
    },
    {
      "id": "macro-arguments",
      "description": "Two positional macro arguments and expansion.",
      "profile": "latex-basic",
      "features": [
        "macros",
        "arguments"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "visible_text",
          "source": {
            "path": "main.tex",
            "start_byte": 75,
            "end_byte": 93,
            "text": "\\pair{left}{right}"
          },
          "detail": "Expansion produces left then right. Braces delimiting arguments do not print."
        }
      ]
    },
    {
      "id": "macro-scope",
      "description": "Group-local macro redefinition restores outer binding.",
      "profile": "latex-basic",
      "features": [
        "macros",
        "scope"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "visible_text",
          "source": {
            "path": "main.tex",
            "start_byte": 67,
            "end_byte": 119,
            "text": "\\word{} {\\renewcommand{\\word}{inner}\\word{}} \\word{}"
          },
          "detail": "Visible words occur in order: outer inner outer. The local redefinition must not escape its group."
        }
      ]
    },
    {
      "id": "unicode-literals",
      "description": "Multibyte text and a subsequent navigation anchor.",
      "profile": "unicode-latex",
      "features": [
        "unicode",
        "source-mapping"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "visible_text",
          "source": {
            "path": "main.tex",
            "start_byte": 41,
            "end_byte": 65,
            "text": "Café naïve — 東京."
          },
          "detail": "Preserve these Unicode characters in a configured font with glyph coverage; unsupported encoding/font must be diagnosed rather than silently dropping text."
        },
        {
          "kind": "source_navigation",
          "source": {
            "path": "main.tex",
            "start_byte": 66,
            "end_byte": 80,
            "text": "After Unicode."
          },
          "detail": "Navigation resolves to UTF-8 bytes of this literal after earlier multibyte characters, not character-count offsets."
        }
      ]
    },
    {
      "id": "math-inline-display",
      "description": "Inline and display math with two-dimensional structure.",
      "profile": "latex-basic",
      "features": [
        "math",
        "scripts",
        "fractions"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "math_layout",
          "source": {
            "path": "main.tex",
            "start_byte": 48,
            "end_byte": 59,
            "text": "$x_1^2 + y$"
          },
          "detail": "Render subscript 1 and superscript 2 on x, then + y in inline math; math delimiters are not printed."
        },
        {
          "kind": "math_layout",
          "source": {
            "path": "main.tex",
            "start_byte": 68,
            "end_byte": 83,
            "text": "\\frac{a+b}{c}=d"
          },
          "detail": "Display a fraction with numerator a+b over denominator c, followed by = d. A plain flattened string is insufficient."
        }
      ]
    },
    {
      "id": "included-file",
      "description": "Included literal retains its own file identity.",
      "profile": "latex-basic",
      "features": [
        "includes",
        "source-mapping"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex",
        "parts/section.tex"
      ],
      "expectations": [
        {
          "kind": "visible_text",
          "source": {
            "path": "parts/section.tex",
            "start_byte": 0,
            "end_byte": 15,
            "text": "Included café."
          },
          "detail": "Render included literal between Before. and After.; visible output retains actual included source identity. Input invocation is expansion ancestry, not the glyph source range."
        },
        {
          "kind": "source_navigation",
          "source": {
            "path": "parts/section.tex",
            "start_byte": 0,
            "end_byte": 15,
            "text": "Included café."
          },
          "detail": "Items directly rendering this literal navigate to parts/section.tex at these byte offsets, not the input command in main.tex."
        }
      ]
    },
    {
      "id": "include-scope",
      "description": "Input obeys the caller macro scope.",
      "profile": "latex-basic",
      "features": [
        "includes",
        "macros",
        "scope"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex",
        "local.tex"
      ],
      "expectations": [
        {
          "kind": "visible_text",
          "source": {
            "path": "main.tex",
            "start_byte": 67,
            "end_byte": 98,
            "text": "{\\input{local}\n\\word{}} \\word{}"
          },
          "detail": "Visible words occur in order inner outer; input executes within the caller group and must not implicitly create or destroy a scope."
        }
      ]
    },
    {
      "id": "comments-escapes",
      "description": "Comments differ from escaped percent and other literal specials.",
      "profile": "latex-basic",
      "features": [
        "comments",
        "escaped-specials"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "visible_text",
          "source": {
            "path": "main.tex",
            "start_byte": 41,
            "end_byte": 63,
            "text": "A% discarded comment\nB"
          },
          "detail": "Comment removes the remainder of its line including the line ending: visible AB, without discarded comment."
        },
        {
          "kind": "visible_text",
          "source": {
            "path": "main.tex",
            "start_byte": 65,
            "end_byte": 98,
            "text": "Price \\$5; 50\\%; A\\&B; C\\_D; \\#1."
          },
          "detail": "Render literal Price $5; 50%; A&B; C_D; #1. without opening math or alignment modes."
        }
      ]
    },
    {
      "id": "unknown-command",
      "description": "Unknown control sequence must remain visible as an error.",
      "profile": "latex-basic",
      "features": [
        "recovery",
        "unsupported-command"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "diagnostic",
          "source": {
            "path": "main.tex",
            "start_byte": 49,
            "end_byte": 72,
            "text": "\\flashtexUnknownCommand"
          },
          "detail": "Report an error at this command with an explicit recovery explanation; never silently report complete success."
        },
        {
          "kind": "recovered_text",
          "source": {
            "path": "main.tex",
            "start_byte": 73,
            "end_byte": 79,
            "text": "After."
          },
          "detail": "Retain Before. and After. in provisional output. Result status recovered; skip/mark the unknown command without inventing its semantics."
        }
      ]
    },
    {
      "id": "unclosed-group",
      "description": "Unclosed source group at document end.",
      "profile": "latex-basic",
      "features": [
        "recovery",
        "groups"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "diagnostic",
          "source": {
            "path": "main.tex",
            "start_byte": 49,
            "end_byte": 56,
            "text": "{inside"
          },
          "detail": "Report the unmatched opening group, or EOF with a related opening location. Explain any inserted closing delimiter."
        },
        {
          "kind": "recovered_text",
          "source": {
            "path": "main.tex",
            "start_byte": 57,
            "end_byte": 70,
            "text": "Still inside."
          },
          "detail": "Keep known preceding text in provisional output; recovered status when pages exist, failed only when no usable output exists."
        }
      ]
    },
    {
      "id": "extra-closing-group",
      "description": "An unmatched close must not discard the entire document.",
      "profile": "latex-basic",
      "features": [
        "recovery",
        "groups"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "diagnostic",
          "source": {
            "path": "main.tex",
            "start_byte": 49,
            "end_byte": 50,
            "text": "}"
          },
          "detail": "Report the extra closing brace at this position and explain skipping/marking it."
        },
        {
          "kind": "recovered_text",
          "source": {
            "path": "main.tex",
            "start_byte": 51,
            "end_byte": 57,
            "text": "After."
          },
          "detail": "Retain Before. and After. after recovering from the unmatched close; result status recovered."
        }
      ]
    },
    {
      "id": "missing-include",
      "description": "Missing project input produces a bounded diagnostic.",
      "profile": "latex-basic",
      "features": [
        "recovery",
        "includes"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "diagnostic",
          "source": {
            "path": "main.tex",
            "start_byte": 49,
            "end_byte": 69,
            "text": "\\input{missing-file}"
          },
          "detail": "Report missing project input at this command; do not hang, fetch a network file, or read arbitrary host paths."
        },
        {
          "kind": "recovered_text",
          "source": {
            "path": "main.tex",
            "start_byte": 70,
            "end_byte": 76,
            "text": "After."
          },
          "detail": "Keep surrounding text in provisional output with recovered status."
        }
      ]
    },
    {
      "id": "literal-source-map",
      "description": "Exact source witnesses independent of layout and Swift indexing.",
      "profile": "unicode-latex",
      "features": [
        "source-mapping",
        "unicode"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "source_navigation",
          "source": {
            "path": "main.tex",
            "start_byte": 46,
            "end_byte": 58,
            "text": "UniqueAnchor"
          },
          "detail": "A click on the directly rendered UniqueAnchor selects its exact original UTF-8 byte span in this input revision."
        },
        {
          "kind": "source_navigation",
          "source": {
            "path": "main.tex",
            "start_byte": 59,
            "end_byte": 62,
            "text": "尾"
          },
          "detail": "The source end offset is exclusive and lands at a UTF-8 boundary even for a multibyte literal."
        }
      ]
    },
    {
      "id": "tikz-required",
      "description": "A required package-level feature; prevents subset success being called full compatibility.",
      "profile": "latex-tikz",
      "features": [
        "packages",
        "diagrams",
        "compatibility"
      ],
      "support": "required_unverified",
      "entry_path": "main.tex",
      "documents": [
        "main.tex"
      ],
      "expectations": [
        {
          "kind": "required_feature",
          "source": {
            "path": "main.tex",
            "start_byte": 24,
            "end_byte": 41,
            "text": "\\usepackage{tikz}"
          },
          "detail": "Full product compatibility requires executing this package and rendering its geometry. Until implemented, diagnose unsupported package/construct explicitly; a placeholder is not a passing rendering."
        },
        {
          "kind": "diagram_layout",
          "source": {
            "path": "main.tex",
            "start_byte": 79,
            "end_byte": 109,
            "text": "\\draw (0,0) -- (1,0) -- (1,1);"
          },
          "detail": "Render two connected perpendicular segments in the TikZ coordinate system, not the source text or an unrelated image."
        }
      ]
    }
  ]
}
