
/// The symbol a command names (aliases resolved); `None` for anything else,
/// including the `@` pieces.
pub fn by_name(name: &str) -> Option<&'static AmsSymbol> {
    if name.contains('@') {
        return None;
    }
    let name = ALIASES
        .iter()
        .find(|(alias, _)| *alias == name)
        .map_or(name, |(_, target)| *target);
    SYMBOLS.iter().find(|s| s.name == name)
}

/// A piece by its internal `@` name (`dabar@`, `widehat@`, ...).
pub fn piece(name: &str) -> Option<&'static AmsSymbol> {
    SYMBOLS.iter().find(|s| s.name == name)
}

/// The symbol set from a font slot.
pub fn by_slot(font: SymbolFont, slot: u8) -> Option<&'static AmsSymbol> {
    SYMBOLS.iter().find(|s| s.font == font && s.slot == slot)
}

/// Every command the table answers, aliases included.
pub fn command_names() -> impl Iterator<Item = &'static str> {
    SYMBOLS
        .iter()
        .map(|s| s.name)
        .filter(|n| !n.contains('@'))
        .chain(ALIASES.iter().map(|(alias, _)| *alias))
}

/// Advance of a Latin Modern Math character of this table.
pub fn lm_advance(c: char) -> Option<u16> {
    static INDEX: crate::char_table::CharTable<u16> =
        crate::char_table::CharTable::new(LM_ADVANCES);
    INDEX.get(c)
}

/// Advance of a character only New Computer Modern Math carries.
pub fn newcm_advance(c: char) -> Option<u16> {
    static INDEX: crate::char_table::CharTable<u16> =
        crate::char_table::CharTable::new(NEWCM_ADVANCES);
    INDEX.get(c)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn slots_are_unique_and_every_text_has_a_bound_face() {
        for (i, s) in SYMBOLS.iter().enumerate() {
            assert!(
                SYMBOLS[..i].iter().all(|t| (t.font, t.slot) != (s.font, s.slot)),
                "\\{} repeats a slot",
                s.name
            );
            assert!(
                SYMBOLS[..i].iter().all(|t| t.name != s.name),
                "\\{} listed twice",
                s.name
            );
            for c in s.text.chars() {
                let bound = match s.face {
                    Face::LatinModernMath => lm_advance(c).is_some(),
                    Face::NewComputerModernMath => {
                        newcm_advance(c).is_some() || lm_advance(c).is_some()
                    }
                    Face::None => false,
                };
                assert!(bound, "\\{} text {c:?} has no advance entry", s.name);
            }
            assert_eq!(s.text.is_empty(), s.face == Face::None, "\\{}", s.name);
        }
    }

    #[test]
    fn declarations_and_aliases_resolve() {
        let leq = by_name("leqslant").expect("amssymb.sty:101");
        assert_eq!((leq.font, leq.slot, leq.class), (SymbolFont::Msam, 0x36, SymbolClass::Rel));
        assert_eq!(by_name("restriction").map(|s| s.name), Some("upharpoonright"));
        assert_eq!(by_name("doublecup").map(|s| s.slot), Some(0x64));
        assert!(by_name("dabar@").is_none());
        assert_eq!(piece("widehat@").map(|s| s.slot), Some(0x5B));
        assert_eq!(by_slot(SymbolFont::Msbm, 0x02).map(|s| s.name), Some("nleq"));
        let ul = by_name("ulcorner").expect("amsfonts.sty:74");
        assert_eq!(ul.class, SymbolClass::Open);
    }
}
