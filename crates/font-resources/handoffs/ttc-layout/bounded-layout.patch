+#[test]
+fn explicit_limits_reject_before_pair_scans_and_header_ranges_are_retained() {
+    use flashtex_font_engine::{CollectionLimits, collection_layout_with_limits};
+    let f = build_ttc(100, 200);
+    let layout = collection_layout(&f).unwrap();
+    assert_eq!(layout.header, 0..20);
+    assert_eq!(layout.faces[0].directory, 100..144);
+    for limits in [
+        CollectionLimits {
+            faces: 1,
+            ..Default::default()
+        },
+        CollectionLimits {
+            tables_per_face: 1,
+            ..Default::default()
+        },
+        CollectionLimits {
+            total_tables: 3,
+            ..Default::default()
+        },
+        CollectionLimits {
+            comparisons: 43,
+            ..Default::default()
+        },
+    ] {
+        assert!(collection_layout_with_limits(&f, limits).is_err());
+    }
+    assert!(
+        collection_layout_with_limits(
+            &f,
+            CollectionLimits {
+                comparisons: 44,
+                ..Default::default()
+            }
+        )
+        .is_ok()
+    );
+}
+#[test]
+fn header_version_directory_and_shared_tag_contract() {
+    let f = build_ttc(100, 200);
+    for version in [0u32, 0x20000, 0x90000] {
+        let mut b = f.clone();
+        b[4..8].copy_from_slice(&version.to_be_bytes());
+        assert!(collection_layout(&b).is_err());
+    }
+    let mut b = f.clone();
+    b[100..104].copy_from_slice(&0xdeadbeefu32.to_be_bytes());
+    assert!(collection_layout(&b).is_err());
+    for offset in [0u32, 100, 200] {
+        let mut b = f.clone();
+        b[120..124].copy_from_slice(&offset.to_be_bytes());
+        assert!(collection_layout(&b).is_err());
+    }
+    let mut b = f.clone();
+    b[16..20].copy_from_slice(&100u32.to_be_bytes());
+    assert!(collection_layout(&b).is_err());
+    let mut b = f;
+    b[212..216].copy_from_slice(b"TEST");
+    assert!(collection_layout(&b).is_err());
+}
