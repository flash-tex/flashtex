+use flashtex_compiler::{export::{map_char, Glyph, ExportFont}, incremental::{compile_full, Session, LayoutConstraints}};
+#[test]
+fn logical_symbols_encode_and_keep_spans() {
+    for (command,glyph,code) in [("vee",'∨',0xda),("Rightarrow",'⇒',0xde)] {
+        assert_eq!(map_char(glyph),Glyph::Encodable{font:ExportFont::Symbol,code});
+        let source=format!("é $x\\{command} y_i$");
+        let result=compile_full(&source,LayoutConstraints::default());assert!(result.diagnostics.is_empty());
+        let item=result.pages.iter().flat_map(|p|&p.items).find(|i|i.text==glyph.to_string()).unwrap();
+        assert_eq!(&source[item.span.start..item.span.end],format!("\\{command}"));
+    }
+}
+#[test]
+fn logical_edits_and_unresolved_neighbors_remain_explicit() {
+    let mut session=Session::new();
+    for source in [r"$a\vee b$",r"\[a\Rightarrow b^2\]",r"\newcommand{\implieshere}{\Rightarrow}$a\implieshere b$",r"$a\mid b\setminus c\Longrightarrow d$"] {
+        let result=session.compile(source,LayoutConstraints::default());let clean=compile_full(source,LayoutConstraints::default());
+        assert_eq!(result.output.pages,clean.pages);assert_eq!(result.output.diagnostics,clean.diagnostics);
+        if source.contains("mid") {for name in ["mid","setminus","Longrightarrow"] {assert!(clean.diagnostics.iter().any(|d|d.message.contains(name)&&d.message.contains("not supported")));}}
+        else {assert!(clean.diagnostics.is_empty(),"{:?}",clean.diagnostics);}
+    }
+}
