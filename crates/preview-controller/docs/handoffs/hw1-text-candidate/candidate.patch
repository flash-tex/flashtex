+        (r"é \input{chapter}", r"é $x_{\text{and}}$", true),
+        (r"é \input{chapter}", r"é $x_{\text{a b}}$", true),
+    ] {
+        let mut documents = vec![
+            SourceDocument {
+                path: "main.tex",
+                text: entry,
+            },
+            SourceDocument {
+                path: "chapter.tex",
+                text: chapter,
+            },
+        ];
+        if reverse {
+            documents.reverse();
+        }
+        let clean = compile_full_project(&documents, "main.tex", LayoutConstraints::default());
+        let incremental =
+            session.compile_project(&documents, "main.tex", LayoutConstraints::default());
+        assert_eq!(clean.pages, incremental.output.pages);
+        assert_eq!(clean.diagnostics, incremental.output.diagnostics);
+        assert!(clean.diagnostics.is_empty(), "{:?}", clean.diagnostics);
+        let item = clean
+            .pages
+            .iter()
+            .flat_map(|p| &p.items)
+            .find(|i| i.text == "and" || i.text == "a b")
+            .unwrap();
+        assert_eq!(documents[item.span.document.0].path, "chapter.tex");
+        let raw = &chapter[item.span.start..item.span.end];
+        assert_eq!(
+            raw,
+            if item.text == "and" {
+                r"\text{and}"
+            } else {
+                r"\text{a b}"
+            }
+        );
+    }
+}
