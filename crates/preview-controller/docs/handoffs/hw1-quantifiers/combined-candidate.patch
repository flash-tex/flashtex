+use flashtex_compiler::{export::{map_char, Glyph, ExportFont}, incremental::{compile_full, Session, LayoutConstraints}};
+#[test]
+fn quantifiers_export_and_preserve_command_spans() {
+    for (command, glyph, code) in [("forall", '∀', 0x22), ("exists", '∃', 0x24)] {
+        assert_eq!(map_char(glyph), Glyph::Encodable{font:ExportFont::Symbol,code});
+        let source=format!("é $\\{command}_i x$");
+        let output=compile_full(&source,LayoutConstraints::default());
+        assert!(output.diagnostics.is_empty(),"{:?}",output.diagnostics);
+        let item=output.pages.iter().flat_map(|p| &p.items).find(|i| i.text==glyph.to_string()).unwrap();
+        assert_eq!(&source[item.span.start..item.span.end],format!("\\{command}"));
+    }
+}
+#[test]
+fn quantifier_macro_bang_and_incremental_edits() {
+    let mut session=Session::new();
+    for source in [r"$\forall x\exists y$",r"\[\forall x\exists! y_i\]",r"\newcommand{\some}{\exists}$\some x$",r"$\unknownquantifier x$"] {
+        let clean=compile_full(source,LayoutConstraints::default());
+        let incremental=session.compile(source,LayoutConstraints::default());
+        assert_eq!(clean.pages,incremental.output.pages);
+        assert_eq!(clean.diagnostics,incremental.output.diagnostics);
+        if source.contains("unknownquantifier") {assert!(clean.diagnostics.iter().any(|d|d.message.contains("unknownquantifier")));}
+        else {assert!(clean.diagnostics.is_empty(),"{:?}",clean.diagnostics);}
+        if source.contains("exists!"){assert!(clean.pages.iter().flat_map(|p|&p.items).any(|i|i.text=="!"));}
+    }
+}
