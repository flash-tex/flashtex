+use flashtex_compiler::{
+    incremental::{compile_full, LayoutConstraints, Session},
+    layout::Font,
+    lexer,
+    math::{self, Nucleus},
+};
+
+#[test]
+fn literal_groups_are_distinct_roman_text_with_group_spans() {
+    for text in ["(a)", "(b)", "(c)", "(d)", "and", "a b", "", "{x}"] {
+        let body = if text == "{x}" { r"\{x\}" } else { text };
+        let source = format!(r"\text{{{body}}}");
+        let mut diagnostics = Vec::new();
+        let list = math::parse_tokens(&lexer::tokenize(&source), &mut diagnostics);
+        assert!(diagnostics.is_empty(), "{diagnostics:?}");
+        assert_eq!(list.atoms[0].nucleus, Nucleus::Text(text.into()));
+        assert_eq!(
+            &source[list.atoms[0].span.start..list.atoms[0].span.end],
+            source
+        );
+        let boxes = math::layout(&list, 12.0, &mut diagnostics);
+        assert_eq!(boxes.items[0].font, Some(Font::TimesRoman));
+        assert_ne!(list.atoms[0].nucleus, Nucleus::Symbol(text.into()));
+    }
+}
+#[test]
+fn whitespace_comments_and_nested_literal_braces() {
+    for (source, expected) in [
+        (r"\text{a  b}", "a b"),
+        ("\\text{a%comment\nb}", "ab"),
+        (r"\text{a{b}c}", "abc"),
+    ] {
+        let mut diagnostics = Vec::new();
+        let list = math::parse_tokens(&lexer::tokenize(source), &mut diagnostics);
+        assert!(diagnostics.is_empty(), "{diagnostics:?}");
+        assert_eq!(list.atoms[0].nucleus, Nucleus::Text(expected.into()));
+    }
+}
+#[test]
+fn malformed_and_unsupported_text_stays_diagnosed() {
+    for source in [
+        r"\text x",
+        r"\text{a",
+        r"\text{\alpha}",
+        r"\text{é}",
+        "\\text{a\n\nb}",
+    ] {
+        let mut diagnostics = Vec::new();
+        let list = math::parse_tokens(&lexer::tokenize(source), &mut diagnostics);
+        assert!(!diagnostics.is_empty(), "{source}");
+        for d in diagnostics {
+            if let Some(s) = d.span {
+                assert!(source.get(s.start..s.end).is_some());
+            }
+        }
+        if source == r"\text x" {
+            assert_eq!(list.atoms[1].nucleus, Nucleus::Symbol("x".into()));
+        }
+        if source == r"\text{\alpha}" {
+            assert_eq!(list.atoms[0].nucleus, Nucleus::Text(r"\alpha".into()));
+        }
+    }
+    let source = format!("\\text{{{}x{}}}", "{".repeat(2000), "}".repeat(2000));
+    let mut diagnostics = Vec::new();
+    let list = math::parse_tokens(&lexer::tokenize(&source), &mut diagnostics);
+    assert!(diagnostics.iter().any(|d| d.message.contains("depth")));
+    assert_eq!(list.atoms[0].nucleus, Nucleus::Text("x".into()));
+}
+#[test]
+fn scripts_macros_and_incremental_source_shifts_match_clean() {
+    let mut session = Session::new();
+    for source in [
+        r"$x_{\text{and}}$",
+        r"$x_{\text{a b}}$",
+        r"$x_{and}$",
+        r"é $x_{\text{and}}$",
+        r"\newcommand{\labeltext}{\text{and}}$x_{\labeltext}$",
+        r"$x_{\text{\alpha}}$",
+    ] {
+        let clean = compile_full(source, LayoutConstraints::default());
+        let inc = session.compile(source, LayoutConstraints::default());
+        assert_eq!(inc.output.pages, clean.pages);
+        assert_eq!(inc.output.diagnostics, clean.diagnostics);
+        if source.contains("alpha") {
+            assert!(!clean.diagnostics.is_empty());
+        } else {
+            assert!(clean.diagnostics.is_empty(), "{:?}", clean.diagnostics);
+        }
+        for item in clean.pages.iter().flat_map(|p| &p.items) {
+            assert!(source.get(item.span.start..item.span.end).is_some());
+        }
+        if let Some(item) = clean
+            .pages
+            .iter()
+            .flat_map(|p| &p.items)
+            .find(|i| i.text == "and")
+        {
+            assert_eq!(item.font, Font::TimesRoman);
+            assert!(item.font_size_pt < 12.0);
+        }
+    }
+}
+
+#[test]
+fn macro_text_points_to_invocation_not_definition() {
+    let source = r"\newcommand{\labeltext}{\text{and}}é $x_{\labeltext}$";
+    let output = compile_full(source, LayoutConstraints::default());
+    assert!(output.diagnostics.is_empty());
+    let item = output
+        .pages
+        .iter()
+        .flat_map(|p| &p.items)
+        .find(|i| i.text == "and")
+        .unwrap();
+    let start = source.rfind(r"\labeltext").unwrap();
+    assert_eq!(
+        item.span,
+        flashtex_compiler::Span::new(start, start + r"\labeltext".len())
+    );
+}
+
+#[test]
+fn multi_document_text_navigation_tracks_edits_and_document_order() {
+    use flashtex_compiler::{incremental::compile_full_project, parser::SourceDocument};
+    let mut session = Session::new();
+    for (entry, chapter, reverse) in [
+        (r"\input{chapter}", r"$x_{\text{and}}$", false),
+        (r"é \input{chapter}", r"$x_{\text{and}}$", false),
+        (r"é \input{chapter}", r"é $x_{\text{and}}$", false),
+        (r"é \input{chapter}", r"é $x_{\text{and}}$", true),
+        (r"é \input{chapter}", r"é $x_{\text{a b}}$", true),
+    ] {
+        let mut documents = vec![
+            SourceDocument {
+                path: "main.tex",
+                text: entry,
+            },
+            SourceDocument {
+                path: "chapter.tex",
+                text: chapter,
+            },
+        ];
+        if reverse {
+            documents.reverse();
+        }
+        let clean = compile_full_project(&documents, "main.tex", LayoutConstraints::default());
+        let incremental =
+            session.compile_project(&documents, "main.tex", LayoutConstraints::default());
+        assert_eq!(clean.pages, incremental.output.pages);
+        assert_eq!(clean.diagnostics, incremental.output.diagnostics);
+        assert!(clean.diagnostics.is_empty(), "{:?}", clean.diagnostics);
+        let item = clean
+            .pages
+            .iter()
+            .flat_map(|p| &p.items)
+            .find(|i| i.text == "and" || i.text == "a b")
+            .unwrap();
+        assert_eq!(documents[item.span.document.0].path, "chapter.tex");
+        let raw = &chapter[item.span.start..item.span.end];
+        assert_eq!(
+            raw,
+            if item.text == "and" {
+                r"\text{and}"
+            } else {
+                r"\text{a b}"
+            }
+        );
+    }
+}
+
+#[test]
+fn comments_before_text_argument_do_not_hide_the_group() {
+    let source = "\\text% note\n {and}";
+    let mut diagnostics = Vec::new();
+    let list = math::parse_tokens(&lexer::tokenize(source), &mut diagnostics);
+    assert!(diagnostics.is_empty(), "{diagnostics:?}");
+    assert_eq!(list.atoms.len(), 1);
+    assert_eq!(list.atoms[0].nucleus, Nucleus::Text("and".into()));
+    assert_eq!(
+        &source[list.atoms[0].span.start..list.atoms[0].span.end],
+        source
+    );
+}
