# web2rust configuration for the XeTeX port (src/generated/, xetex.pool).
#
# The engine is TeX Live 2026's xetex.web (third_party/xetex/xetex.web, never
# edited) plus the change files of changes/, applied in this order, which
# re-specify what web2c's tex.ch and TeX Live's xetexdir/xetex.ch supply
# (DESIGN.md section 4.1; docs/design/xetex/PLAN.md). The order follows
# xetexdir/am/xetex.am. The capacities are TeX Live 2026's texmf.cnf values
# for xetex (`kpsewhich -progname=xetex -var-value=...`), which equal
# pdflatex's. Regenerate with scripts/xetex-regenerate.sh; `cargo test
# --manifest-path crates/flashtex-xetex/Cargo.toml --test drift` fails if
# src/generated/ does not match this file.

--change crates/flashtex-xetex/changes/web2c.ch
--change crates/flashtex-xetex/changes/goto.ch
--change crates/flashtex-xetex/changes/precedence.ch
--change crates/flashtex-xetex/changes/ext.ch
--change crates/flashtex-xetex/changes/filenames.ch
--change crates/flashtex-xetex/changes/virtex.ch
--change crates/flashtex-xetex/changes/web2c-hooks.ch
# TeX Live's own feature change files, public domain, unmodified, in the
# order of xetexdir/am/xetex.am (the same files pdfTeX uses).
--change third_party/pdftex/web2c/tracingstacklevels.ch
--change third_party/pdftex/web2c/partoken-102.ch
--change third_party/pdftex/web2c/partoken.ch
--change third_party/pdftex/web2c/locnull-optimize.ch
--change third_party/pdftex/web2c/unbalanced-braces.ch
--change third_party/pdftex/web2c/showstream.ch
--change crates/flashtex-xetex/changes/synctex.ch
--change crates/flashtex-xetex/changes/xetex-web2c.ch
# TeX Live's, public domain, unmodified.
--change third_party/xetex/char-warning-xetex.ch
--change crates/flashtex-xetex/changes/web2c-run.ch

# The engine's state outside the word space (src/state.rs; PLAN.md 4.7): a
# field `host` of Globals, so that the crate has no process-wide state.
--host-state crate::state::Host

# Every array subscript becomes crate::ix::U(...), as in the pdfTeX engine.
--index-type crate::ix::U

--stat                        # stat/tats null: statistics compiled in, as in web2c
# glue_ratio stays xetex.web's `real`, a C double as in web2c's texmfmp.h.


# Halfwords keep xetex.web's own bounds, which are TeX Live's
# (min_halfword=-"FFFFFFF from tex.ch, max_halfword="3FFFFFFF from
# xetex.ch): XeTeX's character codes need more than 28 bits in a token.

# Memory: main_memory=5000000, extra_mem_top=extra_mem_bot=0.
--macro mem_bot=0
--macro mem_top=4999999
--const mem_min=0
--const mem_max=4999999

# Hash: tex.ch's hash_size=15000 and hash_prime=8501, and texmf.cnf's
# hash_extra=600000 above eqtb_size (changes/web2c.ch).
--macro hash_size=15000
--macro hash_prime=8501
--macro hash_extra=600000
--macro hyph_size=8191

--const buf_size=200000
--const stack_size=10000
--const max_in_open=15
--const font_max=9000
--const font_mem_size=8000000
--const param_size=20000
--const nest_size=1000
# texmf.cnf's max_strings=500000 plus the 65536 single-character strings
# XeTeX simulates (xetex.ch [51.1332]: "the max_strings value doesn't
# include the 64K synthetic strings").
--const max_strings=565536
--const string_vacancies=90000
--const pool_size=6250000
--const save_size=200000
--const trie_size=1100000
# Not in texmf.cnf; tex.ch sets 35111.
--const trie_op_size=35111
--const dvi_buf_size=16384
--const file_name_size=1024

# XeTeX's growable buffers (xetex.web grows them in steps of 128).
--arena-cap native_text=1048576

# TeX Live tangles xetex.web with Omega's otangle, which numbers the pool
# strings from 65536: the first 65536 strings are the characters.
--first-string 65536
