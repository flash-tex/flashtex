{
  "_comment": "Explicit acceptance thresholds for tools/native-validation/mac-live/run.sh. 'gates' fail the run; 'informational' lines are reported without failing it. The old engine's typing bench, render-attach, exact-export, worker-relaunch, multi-file and historical sections left with that engine in retirement stage S6 (#1236).",
  "launch_check": {
    "gates": {
      "fail_lines_max": 0,
      "required_notes": [
        "log shows the engine host starting",
        "flashtex-host started, pid=",
        "is still running after its engine host was killed",
        "log shows the host's exit",
        "log shows the host restarting",
        "flashtex-bridge attached, pid=",
        "log shows a bridge 'attached:' status line",
        "is still running after its bridge child was killed",
        "log shows a 'bridge exited (' status line",
        "FlashTeX quit cleanly"
      ],
      "no_activate_env_required": true
    },
    "informational": [
      "CGWindowListCopyWindowInfo confirms an on-screen window",
      "bridge auto-relaunch after kill (not implemented in the shell; recorded, not gated)"
    ]
  },
  "bundle": {
    "gates": {
      "bundled_helper_sha256_equals_built_helper_sha256": true,
      "required_binaries": [
        "FlashTeX",
        "flashtex-bridge",
        "flashtex-edit-ledger",
        "flashtex-host"
      ],
      "optional_binaries": [
        "flashtex-project-files"
      ],
      "components_json_git_sha_equals_source_sha": true
    }
  },
  "capture_cycle": {
    "gates": {
      "bridge_capture_received_durable": true,
      "bridge_convert_error_code": "provider_disabled",
      "bridge_prepare_without_proposal_error_code": "proposal_missing",
      "bridge_journal_survives_sigkill": true,
      "bridge_reject_terminal": true,
      "ledger_apply_receipt": true,
      "ledger_retry_returns_same_receipt": true,
      "ledger_document_survives_sigkill": true,
      "no_network_provider_call": true
    }
  },
  "open_window": {
    "gates": {
      "windows": {
        "a11y-help": "Accessibility Help",
        "nearby": "Nearby Companion"
      },
      "screenshot_min_bytes": 4096,
      "screenshot_min_px": 100,
      "no_activate": true
    }
  },
  "app_tests": {
    "gates": {
      "exit_code": 0,
      "required_passed": [
        "ProjectDocumentsTests/testDirectModeSavesNonEntryDocumentsAndRefusesChangedDisk",
        "DocumentFilesTests/testHelperSaveRefusesExternalChangesUntilOverwriteOrReload",
        "DocumentFilesTests/testReloadIsReviewedAndPinnedToTheReviewedSnapshot"
      ]
    }
  }
}
