diff --git a/crates/flashtex-engine/src/pdftex/images.rs b/crates/flashtex-engine/src/pdftex/images.rs
index 683e79440..32e33646c 100644
--- a/crates/flashtex-engine/src/pdftex/images.rs
+++ b/crates/flashtex-engine/src/pdftex/images.rs
@@ -78,6 +78,54 @@ pub struct State {
     pub epdf: pdftoepdf::State,
 }
 
+// Checkpoint registration (crate::checkpoint), interim: the open image
+// handles (libpng, the JPEG file, xpdf documents) cannot be copied, so a
+// checkpoint is refused while any image or included PDF is loaded, and the
+// state is carried only while it holds none (the image table's size).
+impl State {
+    /// Whether a checkpoint may copy this state.
+    pub fn checkpointable(&self) -> Result<(), String> {
+        if self.images.is_empty() && self.epdf.is_empty() && self.jbig2.is_empty() {
+            Ok(())
+        } else {
+            Err("an image is loaded (\\pdfximage): images are not checkpointed yet".into())
+        }
+    }
+}
+
+impl Clone for State {
+    fn clone(&self) -> State {
+        assert!(self.checkpointable().is_ok(), "cloning loaded images");
+        State {
+            images: vec![],
+            image_limit: self.image_limit,
+            allocated: self.allocated,
+            png: self.png.clone(),
+            jbig2: Default::default(),
+            epdf: Default::default(),
+        }
+    }
+}
+
+impl crate::persist::Codec for State {
+    fn enc(&self, w: &mut Vec<u8>) {
+        self.image_limit.enc(w);
+        self.allocated.enc(w);
+        self.png.enc(w);
+    }
+    fn dec(r: &mut crate::persist::Reader) -> Result<Self, String> {
+        use crate::persist::Codec;
+        Ok(State {
+            images: vec![],
+            image_limit: Codec::dec(r)?,
+            allocated: Codec::dec(r)?,
+            png: Codec::dec(r)?,
+            jbig2: Default::default(),
+            epdf: Default::default(),
+        })
+    }
+}
