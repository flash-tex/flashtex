+            let cb = crate::arena::CHUNK_BYTES;
+            for c in off / cb..(off + len).div_ceil(cb) {
+                let a = v.chunk(c);
+                let b = self.arena.chunk(c);
+                let b: &[u8] = unsafe { std::slice::from_raw_parts(b.as_ptr() as *const u8, cb) };
+                if a == b { continue; }
+                for k in 0..cb / 8 {
+                    let at = c * cb + k * 8;
+                    if at < off || at >= off + len { continue; }
+                    if a[k * 8..k * 8 + 8] != b[k * 8..k * 8 + 8] {
+                        let p = ((at - off) / 8 + 1) as i32;
+                        if crate::readset::is_cs_slot(p) && (p as usize) < n && !w[p as usize] {
+                            w[p as usize] = true;
+                            count += 1;
+                        }
+                    }
+                }
+            }
+        }
+        for (p, &on) in w.iter().enumerate() {
+            if on && self.rs_seen[p] { self.rs_seen[p] = false; }
+        }
+        self.layer().watch = w;
+        eprintln!("[watch] auxdone {count} slots, pages {}", self.total_pages);
+    }
