+    fn proto_watch(&mut self) {
+        let Some(ap) = self.layer().aux_point else { return };
+        let off = self.arena.regions.iter().find(|r| r.name == "eqtb").map(|r| (r.off, r.bytes));
+        let Some((off, len)) = off else { return };
+        let n = self.rs_seen.len();
+        let mut w = std::mem::take(&mut self.layer().watch);
+        w.resize(n, false);
+        let mut count = 0;
