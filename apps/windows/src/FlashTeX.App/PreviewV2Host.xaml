<!--
  Rendering-v2 precision preview surface. One Win2D CanvasControl per page: a
  CanvasControl only redraws on invalidation, resize or device loss, so scrolling
  and panning never rebuild glyph runs. Deliberately NOT a SwapChainPanel — that
  is a custom render loop with no evidence yet that it is needed here.
-->
<UserControl
    x:Class="FlashTeX.App.PreviewV2Host"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer x:Name="PreviewScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PagesPanel" HorizontalAlignment="Center" Spacing="18" Padding="20" />
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Text="Compile to see a preview" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Border x:Name="NoticeBar" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Padding="10,6">
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Border>
    </Grid>
</UserControl>
