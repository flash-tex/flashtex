<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FlashTeX.Protocol\FlashTeX.Protocol.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CsWin32-generated COM interop (Win32SpellChecker.cs) needs unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- CVE check (2026-09-14): Microsoft.Windows.CsWin32 has no open CVEs on the
         GitHub Advisory Database / NVD as of this date; it is a build-time source
         generator (no runtime dependency ships in the output), pinned to an exact
         version per org dependency policy. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Provenance: byte-identical to crates/compiler/supported/supported-latex.json
         (schema flashtex-supported-latex/1), regenerated by flashtex-compiler's
         "supported" CLI flag (two leading dashes) with the "json" argument, and
         drift-gated in the compiler crate. Refresh from the repo root, after
         building flashtex-compiler in release, by running that command and
         redirecting stdout to apps/windows/src/FlashTeX.Editor/Resources/supported-latex.json;
         this mirrors apps/mac/scripts/sync-supported-latex.sh, which does the same
         for the Mac copy. The two bundled copies must stay byte-identical to each
         other (CompletionVocabularyTests.BundledInventoryMatchesTheMacCopy compares
         sha256) and, when refreshed, to the compiler's live output. -->
    <EmbeddedResource Include="Resources\supported-latex.json" />
  </ItemGroup>

</Project>
